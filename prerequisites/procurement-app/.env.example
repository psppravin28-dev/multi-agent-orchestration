# Copy this file to .env and adjust if your credentials differ.
# Matches docker-compose.yml's default procurement/procurement setup.
DATABASE_URL=postgresql+psycopg://procurement:procurement@localhost:5432/procurement

# What the test suite runs against -- a separate database so tests never
# touch your dev data. Auto-created by docker-compose on a fresh volume;
# see README if you already had the volume before this was added.
TEST_DATABASE_URL=postgresql+psycopg://procurement:procurement@localhost:5432/procurement_test
